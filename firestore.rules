rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Nefra Creators Directory Collection
    match /creators/{creatorId} {
      allow read, write: if true;
    }
    
    // Campaign Job Cards Collection
    match /campaign_jobs/{jobId} {
      allow read, write: if true;
    }

    // YouTube Connectors & Telemetry Collection
    match /youtube_connections/{connId} {
      allow read, write: if true;
    }
  }
}
